{
  "name": "azure-cert-gui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Internal Azure and Entra certificate and secret expiration GUI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ui": "node scripts/build-and-start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "fixtures:sync": "tsx scripts/sync-fixtures.ts",
    "sync:fixtures": "tsx scripts/sync-fixtures.ts",
    "sync:azure": "tsx scripts/sync-azure.ts",
    "seed:entra": "tsx scripts/seed-entra-secrets.ts",
    "schedule:launchagent": "tsx scripts/print-launchagent.ts",
    "systemd:write": "node scripts/write-systemd-user-units.mjs",
    "local:azure": "npm run db:migrate && npm run sync:azure -- --verbose && npm run dev",
    "local:fixtures": "npm run db:reset && npm run fixtures:sync -- --verbose && npm run dev"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.13"
  }
}
