GSTACK_DB_PATH=./data/gstack.sqlite

# Optional. When blank, the Azure CLI current account tenant is used.
AZURE_TENANT_ID=

# Optional comma-separated subscription IDs. When blank, enabled Azure CLI subscriptions are scanned.
AZURE_SUBSCRIPTION_IDS=

# Optional comma-separated Key Vault ARM resource IDs. When blank, vaults are discovered from subscriptions.
AZURE_KEYVAULT_RESOURCE_IDS=

# Default true. Set false if Graph owner reads are not consented yet.
AZURE_GRAPH_INCLUDE_OWNERS=true

# Default false. Current Key Vault secrets/certificates are usually enough for rotation tracking.
AZURE_KEYVAULT_INCLUDE_VERSIONS=false
